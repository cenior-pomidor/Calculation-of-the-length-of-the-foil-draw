<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Закреплено сверху: при прокрутке экранов не двигается. -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_app_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher_foreground"
                android:tint="@color/on_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="20sp" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tab_die"
                style="@style/Segment.Start"
                android:text="@string/section_die"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/tab_usage"
                style="@style/Segment.End"
                android:text="@string/usage_title"
                android:textSize="15sp" />
        </RadioGroup>
    </LinearLayout>

    <io.github.ceniorpomidor.foildraw.ui.SwipePager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Экран 1: элементы клише и протяжка. -->
        <ScrollView
            android:id="@+id/page_die"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <!-- Фокусируемый контейнер забирает фокус у поля, когда клавиатуру закрывают. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    style="@style/Card"
                    android:layout_marginTop="4dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/count_title" />

                    <RadioGroup
                        android:id="@+id/count_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/count_title"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/count_2"
                            style="@style/Segment.Start"
                            android:text="2" />

                        <RadioButton
                            android:id="@+id/count_3"
                            style="@style/Segment.Middle"
                            android:text="3" />

                        <RadioButton
                            android:id="@+id/count_4"
                            style="@style/Segment.Middle"
                            android:text="4" />

                        <RadioButton
                            android:id="@+id/count_5"
                            style="@style/Segment.Middle"
                            android:text="5" />

                        <RadioButton
                            android:id="@+id/count_6"
                            style="@style/Segment.Middle"
                            android:text="6" />

                        <RadioButton
                            android:id="@+id/count_7"
                            style="@style/Segment.End"
                            android:text="7" />
                    </RadioGroup>

                    <io.github.ceniorpomidor.foildraw.ui.FoilInputView
                        android:id="@+id/diagram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/InputRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputTitle"
                                android:text="@string/min_gap_title" />

                            <TextView
                                style="@style/InputHint"
                                android:text="@string/min_gap_hint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/min_gap"
                            style="@style/Field"
                            android:layout_width="@dimen/field_width"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />

                        <TextView style="@style/Unit" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/invalid_input"
                    style="@style/Card"
                    android:text="@string/invalid_input"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_hero"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/result_title"
                            android:textColor="@color/on_primary_container"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/pull_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_primary_container"
                            android:textSize="38sp" />

                        <TextView
                            android:id="@+id/pull_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:textColor="@color/on_primary_container"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/Tile">

                            <TextView
                                style="@style/TileLabel"
                                android:text="@string/clearance_title" />

                            <TextView
                                android:id="@+id/clearance_value"
                                style="@style/TileValue" />

                            <TextView
                                style="@style/TileHint"
                                android:text="@string/clearance_hint" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Tile"
                            android:layout_marginStart="10dp">

                            <TextView
                                style="@style/TileLabel"
                                android:text="@string/savings_title" />

                            <TextView
                                android:id="@+id/savings_value"
                                style="@style/TileValue" />

                            <TextView
                                android:id="@+id/savings_hint"
                                style="@style/TileHint" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Лента прокручивается внутри своего блока, бесконечно. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/scheme_block_height"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/SectionTitle"
                            android:text="@string/scheme_title" />

                        <io.github.ceniorpomidor.foildraw.ui.FoilSchemeView
                            android:id="@+id/scheme"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="4dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/scheme_hint"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Экран 2: расход фольги. -->
        <ScrollView
            android:id="@+id/page_usage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    style="@style/Card"
                    android:layout_marginTop="4dp">

                    <LinearLayout style="@style/InputRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputTitle"
                                android:text="@string/run_title" />

                            <TextView
                                style="@style/InputHint"
                                android:text="@string/run_hint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/run"
                            style="@style/Field"
                            android:layout_width="@dimen/field_width"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number" />

                        <TextView
                            style="@style/Unit"
                            android:text="@string/unit_pcs" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/InputRow"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputTitle"
                                android:text="@string/per_strike_title" />

                            <TextView
                                style="@style/InputHint"
                                android:text="@string/per_strike_hint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/per_strike"
                            style="@style/Field"
                            android:layout_width="@dimen/field_width"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number" />

                        <TextView
                            style="@style/Unit"
                            android:text="@string/unit_pcs" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/InputRow"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputTitle"
                                android:text="@string/roll_title" />

                            <TextView
                                style="@style/InputHint"
                                android:text="@string/roll_hint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/roll_length"
                            style="@style/Field"
                            android:layout_width="@dimen/field_width"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />

                        <TextView
                            style="@style/Unit"
                            android:text="@string/unit_m" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <TextView
                        android:id="@+id/usage_missing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout style="@style/StatRow">

                            <TextView
                                style="@style/StatLabel"
                                android:text="@string/usage_strikes_title" />

                            <TextView
                                android:id="@+id/usage_strikes"
                                style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatRow">

                            <TextView
                                style="@style/StatLabel"
                                android:text="@string/usage_run_title" />

                            <TextView
                                android:id="@+id/usage_run"
                                style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatRow">

                            <TextView
                                android:id="@+id/usage_make_ready_title"
                                style="@style/StatLabel" />

                            <TextView
                                android:id="@+id/usage_make_ready"
                                style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_total"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/usage_total_title"
                                    android:textColor="@color/on_secondary_container"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/usage_total_hint"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.8"
                                    android:textColor="@color/on_secondary_container"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/usage_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/on_secondary_container"
                                android:textSize="26sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </io.github.ceniorpomidor.foildraw.ui.SwipePager>
</LinearLayout>
