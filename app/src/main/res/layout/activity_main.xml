<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="30sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle"
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp" />

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/count_title" />

                <RadioGroup
                    android:id="@+id/count_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/count_2"
                        style="@style/Segment"
                        android:text="2" />

                    <RadioButton
                        android:id="@+id/count_3"
                        style="@style/Segment"
                        android:layout_marginStart="8dp"
                        android:text="3" />

                    <RadioButton
                        android:id="@+id/count_4"
                        style="@style/Segment"
                        android:layout_marginStart="8dp"
                        android:text="4" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/diagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <View style="@style/Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputTitle"
                            android:text="@string/min_gap_title" />

                        <TextView
                            style="@style/InputHint"
                            android:text="@string/min_gap_hint" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/min_gap"
                        style="@style/Field"
                        android:layout_width="@dimen/field_width"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal" />

                    <TextView style="@style/Unit" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    android:id="@+id/invalid_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/invalid_input"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/result_title" />

                    <TextView
                        android:id="@+id/pull_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/primary"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/pull_window"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="15sp" />

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/StatRow">

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/clearance_title" />

                        <TextView
                            android:id="@+id/clearance_value"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/savings_title"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/savings_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/outline"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/savings_value"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/scheme_title" />

                    <io.github.ceniorpomidor.foildraw.ui.FoilSchemeView
                        android:id="@+id/scheme"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/scheme_hint"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/usage_title" />

                <LinearLayout
                    style="@style/InputRow"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputTitle"
                            android:text="@string/run_title" />

                        <TextView
                            style="@style/InputHint"
                            android:text="@string/run_hint" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/run"
                        style="@style/Field"
                        android:layout_width="@dimen/field_width"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext"
                        android:inputType="number" />

                    <TextView
                        style="@style/Unit"
                        android:text="@string/unit_pcs" />
                </LinearLayout>

                <LinearLayout
                    style="@style/InputRow"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputTitle"
                            android:text="@string/roll_title" />

                        <TextView
                            style="@style/InputHint"
                            android:text="@string/roll_hint" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/roll_length"
                        style="@style/Field"
                        android:layout_width="@dimen/field_width"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/Unit"
                        android:text="@string/unit_m" />
                </LinearLayout>

                <View style="@style/Divider" />

                <TextView
                    android:id="@+id/usage_missing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/StatRow">

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/usage_run_title" />

                        <TextView
                            android:id="@+id/usage_run"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatRow">

                        <TextView
                            android:id="@+id/usage_make_ready_title"
                            style="@style/StatLabel" />

                        <TextView
                            android:id="@+id/usage_make_ready"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/usage_total_title"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/usage_total_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/outline"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/usage_total"
                            style="@style/StatValue"
                            android:textColor="@color/primary"
                            android:textSize="24sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
