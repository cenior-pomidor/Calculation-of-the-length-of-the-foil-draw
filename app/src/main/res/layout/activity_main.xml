<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <!-- Фокусируемый контейнер забирает фокус у поля, когда клавиатуру закрывают. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_app_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launcher_foreground"
                    android:tint="@color/on_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="@color/on_surface"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/SectionHeader">

                    <TextView
                        style="@style/StepBadge"
                        android:text="1" />

                    <TextView
                        style="@style/SectionHeaderText"
                        android:text="@string/section_die" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/count_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/count_title"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/count_2"
                        style="@style/Segment.Start"
                        android:text="@string/count_2" />

                    <RadioButton
                        android:id="@+id/count_3"
                        style="@style/Segment.Middle"
                        android:text="@string/count_3" />

                    <RadioButton
                        android:id="@+id/count_4"
                        style="@style/Segment.End"
                        android:text="@string/count_4" />
                </RadioGroup>

                <io.github.ceniorpomidor.foildraw.ui.FoilInputView
                    android:id="@+id/diagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <View style="@style/Divider" />

                <LinearLayout style="@style/InputRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputTitle"
                            android:text="@string/min_gap_title" />

                        <TextView
                            style="@style/InputHint"
                            android:text="@string/min_gap_hint" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/min_gap"
                        style="@style/Field"
                        android:layout_width="@dimen/field_width"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <TextView style="@style/Unit" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/SectionHeader">

                    <TextView
                        style="@style/StepBadge"
                        android:text="2" />

                    <TextView
                        style="@style/SectionHeaderText"
                        android:text="@string/section_pull" />
                </LinearLayout>

                <TextView
                    android:id="@+id/invalid_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/invalid_input"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_hero"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/result_title"
                            android:textColor="@color/on_primary_container"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/pull_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_primary_container"
                            android:textSize="44sp" />

                        <TextView
                            android:id="@+id/pull_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:textColor="@color/on_primary_container"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/Tile">

                            <TextView
                                style="@style/TileLabel"
                                android:text="@string/clearance_title" />

                            <TextView
                                android:id="@+id/clearance_value"
                                style="@style/TileValue" />

                            <TextView
                                style="@style/TileHint"
                                android:text="@string/clearance_hint" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Tile"
                            android:layout_marginStart="12dp">

                            <TextView
                                style="@style/TileLabel"
                                android:text="@string/savings_title" />

                            <TextView
                                android:id="@+id/savings_value"
                                style="@style/TileValue" />

                            <TextView
                                android:id="@+id/savings_hint"
                                style="@style/TileHint" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="@string/scheme_title" />

                    <io.github.ceniorpomidor.foildraw.ui.FoilSchemeView
                        android:id="@+id/scheme"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/scheme_hint"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/SectionHeader">

                    <TextView
                        style="@style/StepBadge"
                        android:text="3" />

                    <TextView
                        style="@style/SectionHeaderText"
                        android:text="@string/usage_title" />
                </LinearLayout>

                <LinearLayout
                    style="@style/InputRow"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputTitle"
                            android:text="@string/run_title" />

                        <TextView
                            style="@style/InputHint"
                            android:text="@string/run_hint" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/run"
                        style="@style/Field"
                        android:layout_width="@dimen/field_width"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <TextView
                        style="@style/Unit"
                        android:text="@string/unit_pcs" />
                </LinearLayout>

                <LinearLayout
                    style="@style/InputRow"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputTitle"
                            android:text="@string/roll_title" />

                        <TextView
                            style="@style/InputHint"
                            android:text="@string/roll_hint" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/roll_length"
                        style="@style/Field"
                        android:layout_width="@dimen/field_width"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/Unit"
                        android:text="@string/unit_m" />
                </LinearLayout>

                <View style="@style/Divider" />

                <TextView
                    android:id="@+id/usage_missing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/StatRow">

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/usage_run_title" />

                        <TextView
                            android:id="@+id/usage_run"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatRow">

                        <TextView
                            android:id="@+id/usage_make_ready_title"
                            style="@style/StatLabel" />

                        <TextView
                            android:id="@+id/usage_make_ready"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_total"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/usage_total_title"
                                android:textColor="@color/on_secondary_container"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/usage_total_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:textColor="@color/on_secondary_container"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/usage_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_secondary_container"
                            android:textSize="26sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
