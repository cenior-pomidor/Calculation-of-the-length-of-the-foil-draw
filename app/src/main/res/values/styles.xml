<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Заголовок карточки: номер шага в кружке и название. -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="StepBadge">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SectionHeaderText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <!-- На Android 8 атрибута ещё нет, там он просто игнорируется. -->
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Сегменты соединённого переключателя, как у кнопок Material 3. -->
    <style name="Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Segment.Start">
        <item name="android:background">@drawable/bg_segment_start</item>
    </style>

    <style name="Segment.Middle">
        <item name="android:background">@drawable/bg_segment_middle</item>
        <item name="android:layout_marginStart">-1dp</item>
    </style>

    <style name="Segment.End">
        <item name="android:background">@drawable/bg_segment_end</item>
        <item name="android:layout_marginStart">-1dp</item>
    </style>

    <style name="Field" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/outline</item>
        <item name="android:textSize">18sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:maxLength">7</item>
        <item name="android:hint">0</item>
        <item name="android:imeOptions">actionDone</item>
    </style>

    <!-- Поле внутри рамки со «мм»: рамку и её состояния рисует контейнер. -->
    <style name="Field.Bare">
        <item name="android:background">@null</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="BoxUnit">
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:text">@string/unit_mm</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Unit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <!-- Одна ширина для «мм», «шт» и «м», чтобы поля стояли в одну колонку. -->
        <item name="android:minWidth">28dp</item>
        <item name="android:text">@string/unit_mm</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="InputRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="InputTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="InputHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Плитка с одним показателем результата. -->
    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="TileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TileHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StatRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:alpha">0.3</item>
        <item name="android:background">@color/outline</item>
    </style>
</resources>
